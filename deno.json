{
  "name": "@synitio/kv-magic-link-auth",
  "version": "0.2.1",
  "description": "Deno KV backed magic-link authentication for server-side Deno apps.",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno task test",
    "test": "deno test --unstable-kv --allow-read --allow-write mod_test.ts security_test.ts cookies_test.ts",
    "e2e": "deno run -A e2e/run.ts",
    "browser:install": "deno run -A playwright install --only-shell chromium",
    "test:browser": "deno test --unstable-kv -A e2e/browser_test.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "nodemailer": "npm:nodemailer@^10.0.0",
    "playwright": "npm:playwright@^1.63.0"
  },
  "fmt": {
    "semiColons": true,
    "singleQuote": false
  },
  "publish": {
    "exclude": [
      ".gitignore",
      "CHANGELOG.md",
      "e2e",
      "mod_test.ts",
      "security_test.ts",
      "cookies_test.ts"
    ]
  }
}
